{
  "workflow_repair": {
    "path": "/app/workflow/rate_bill.py",
    "cli_usage": "python3 /app/workflow/rate_bill.py --input PATH --output-dir PATH",
    "defaults": {
      "input": "/app/data/meter_reads.json",
      "output_dir": "/app/output",
      "effective_rate_table": "/app/data/effective_rate_table.json",
      "service_class_register": "/app/data/service_class_register.json",
      "billing_policies": "/app/data/billing_policies.json"
    },
    "prohibited_imports": [
      "decimal",
      "fractions",
      "pandas",
      "numpy"
    ],
    "prohibited_dynamic_loading": [
      "importlib",
      "__import__",
      "eval",
      "exec",
      "compile",
      "import_module"
    ],
    "import_rule": "the standard library only, none of prohibited_imports, and nothing reached at run time through prohibited_dynamic_loading: a module the parse tree never names is not an import anyone can check"
  },
  "consolidation_output": {
    "output_path": "/app/data/effective_rate_table.json",
    "container": "object",
    "required_fields": [
      "tariff_id",
      "schedules"
    ],
    "schedules": {
      "container": "array of schedule objects",
      "item_sort": "effective_from ascending",
      "required_fields": [
        "effective_from",
        "classes"
      ]
    },
    "schedule_classes": {
      "container": "object keyed by service class name",
      "key_sort": "ascending",
      "required_fields": [
        "brackets",
        "demand_rate_cents_per_kw",
        "standing_charge_cents_per_day"
      ]
    },
    "brackets": {
      "container": "array of bracket objects",
      "item_sort": "upper_kwh ascending with the unbounded brackets last, ties by bracket_id ascending; a schedule may carry more than one unbounded bracket, or none",
      "required_fields": [
        "bracket_id",
        "upper_kwh",
        "rate_per_kwh_cents"
      ]
    }
  },
  "output_files": {
    "billing_summary_json": "billing_summary.json",
    "bill_register_json": "bill_register.json",
    "exception_queue_jsonl": "exception_queue.jsonl",
    "additional_files_allowed": false
  },
  "field_types": {
    "consumption_kwh": {
      "type": "integer",
      "input_coercion": "int(str(value).strip()); on failure int(float(str(value).strip())); on failure 0; negative results clamp to 0"
    },
    "peak_demand_kw": {
      "type": "integer",
      "input_coercion": "int(str(value).strip()); on failure int(float(str(value).strip())); on failure 0; negative results clamp to 0"
    },
    "estimated": {
      "type": "boolean",
      "input_coercion": "booleans unchanged; strings true/1/yes after str(...).strip().lower() -> true; other strings -> false; other types -> bool(value)"
    },
    "period_start": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "format_note": "exactly YYYY-MM-DD and nothing else; the wider forms a permissive ISO parser accepts, such as a compact 20260106 or a week date 2026-W02-1, are not dates here"
    },
    "period_end": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "format_note": "exactly YYYY-MM-DD and nothing else; the wider forms a permissive ISO parser accepts, such as a compact 20260106 or a week date 2026-W02-1, are not dates here"
    },
    "effective_from": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "format_note": "exactly YYYY-MM-DD and nothing else; the wider forms a permissive ISO parser accepts, such as a compact 20260106 or a week date 2026-W02-1, are not dates here"
    },
    "account": {
      "type": "string"
    },
    "read_id": {
      "type": "string",
      "input_coercion": "internal whitespace runs collapse to a single space; the collapsed form is the identity a read is deduplicated on and the one reported"
    },
    "service_class": {
      "type": "string"
    },
    "upper_kwh": {
      "type": [
        "integer",
        "null"
      ]
    },
    "minimum_applied": {
      "type": "boolean"
    },
    "tier": {
      "type": "string",
      "enum": [
        "escalate",
        "review",
        "watch"
      ]
    },
    "tier_counts": {
      "type": "object",
      "keys": [
        "escalate",
        "review",
        "watch"
      ]
    },
    "bracket_ids": {
      "type": "array",
      "items": "string",
      "order": "ascending"
    },
    "schedule_versions_applied": {
      "type": "array",
      "items": "string",
      "order": "ascending"
    },
    "segment_days": {
      "type": "array",
      "items": "integer",
      "order": "chronological by segment"
    },
    "segment_consumption_kwh": {
      "type": "array",
      "items": "integer",
      "order": "chronological by segment"
    }
  },
  "bill_register": {
    "output_path": "bill_register.json",
    "container": "object keyed by account, each value the array of that account's bill objects",
    "key_sort": "ascending",
    "item_sort": "period_start ascending then read_id ascending",
    "required_fields": [
      "read_id",
      "service_class",
      "period_start",
      "period_end",
      "billed_days",
      "segment_count",
      "segment_days",
      "segment_consumption_kwh",
      "consumption_kwh",
      "peak_demand_kw",
      "ratchet_floor_kw",
      "billed_demand_kw",
      "ratchet_uplift_kw",
      "bracket_ids",
      "bracket_span",
      "schedule_versions_applied",
      "energy_charge_cents",
      "demand_charge_cents",
      "standing_charge_cents",
      "subtotal_cents",
      "minimum_applied",
      "billed_subtotal_cents",
      "levy_cents",
      "total_due_cents",
      "estimated",
      "exception_score"
    ]
  },
  "exception_queue": {
    "output_path": "exception_queue.jsonl",
    "container": "one compact JSON object per line, json.dumps(..., separators=(',', ':')), each line ended by a newline including the last, and no blank line anywhere",
    "bill_id_format": "{account}:{read_id}:{period_start}",
    "required_fields": [
      "bill_id",
      "account",
      "read_id",
      "service_class",
      "period_start",
      "period_end",
      "billed_days",
      "segment_count",
      "segment_days",
      "segment_consumption_kwh",
      "consumption_kwh",
      "peak_demand_kw",
      "ratchet_floor_kw",
      "billed_demand_kw",
      "ratchet_uplift_kw",
      "bracket_ids",
      "bracket_span",
      "schedule_versions_applied",
      "energy_charge_cents",
      "demand_charge_cents",
      "standing_charge_cents",
      "subtotal_cents",
      "minimum_applied",
      "billed_subtotal_cents",
      "levy_cents",
      "total_due_cents",
      "estimated",
      "exception_score",
      "tier"
    ]
  },
  "billing_summary": {
    "output_path": "billing_summary.json",
    "container": "object",
    "schema_version": "tariff-bill-v1",
    "required_fields": [
      "schema_version",
      "raw_read_count",
      "unique_read_ids",
      "dropped_read_count",
      "canonical_read_count",
      "account_count",
      "bill_count",
      "estimated_bill_count",
      "schedule_version_count",
      "tier_counts",
      "total_energy_charge_cents",
      "total_demand_charge_cents",
      "total_standing_charge_cents",
      "total_levy_cents",
      "total_due_cents",
      "minimum_applied_count",
      "queued_bill_count",
      "max_exception_score",
      "max_total_due_cents",
      "max_ratchet_uplift_kw",
      "largest_bill_cents"
    ],
    "tier_counts_key_order": [
      "escalate",
      "review",
      "watch"
    ]
  },
  "meter_read_source": {
    "path": "/app/data/meter_reads.json",
    "shape": "[{\"read_id\": str, \"account\": str, \"service_class\": str, \"period_start\": str, \"period_end\": str, \"consumption_kwh\": int, \"peak_demand_kw\": int, \"estimated\": bool, \"note\": str}, ...]"
  },
  "base_tariff_source": {
    "path": "/app/data/base_tariff.json",
    "shape": "{\"tariff_id\": str, \"effective_from\": str, \"classes\": {class: {\"brackets\": [{\"bracket_id\": str, \"upper_kwh\": int|null, \"rate_per_kwh_cents\": int}, ...], \"demand_rate_cents_per_kw\": int, \"standing_charge_cents_per_day\": int}, ...}}"
  },
  "amendment_filings_source": {
    "path": "/app/data/amendment_filings.json",
    "shape": "[{\"filing_id\": str, \"docket\": str, \"filed_on\": str, \"effective_date\": str, \"status\": str, \"service_class\": str, \"operation\": str, \"bracket\": {\"bracket_id\": str, \"upper_kwh\": int|null, \"rate_per_kwh_cents\": int}?, \"bracket_id\": str?, \"demand_rate_cents_per_kw\": int?, \"rationale\": str}, ...]",
    "status_values": [
      "approved",
      "pending",
      "withdrawn"
    ],
    "operation_values": [
      "replace-bracket",
      "add-bracket",
      "retire-bracket",
      "adjust-demand-charge"
    ]
  },
  "service_class_register_source": {
    "path": "/app/data/service_class_register.json",
    "shape": "[{\"account\": str, \"service_class\": str, \"effective_from\": str}, ...]"
  },
  "policy_source": {
    "path": "/app/data/billing_policies.json",
    "shape": "{\"default\": {field: int, ...}, \"class_overrides\": {service_class: {field: int, ...}, ...}}"
  }
}
